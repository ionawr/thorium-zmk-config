#pragma once

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/* Miryoku tap-dance: single tap = &none, double tap = &to LAYER */

#define MIRYOKU_TD(NAME, LAYER) \
    NAME: NAME { \
        compatible = "zmk,behavior-tap-dance"; \
        #binding-cells = <0>; \
        tapping-term-ms = <200>; \
        bindings = <&none>, <&to LAYER>; \
    };

/* device tree */

&mt {
    tapping-term-ms = <200>;
    quick-tap-ms = <200>;
    flavor = "balanced";
};

&lt {
    tapping-term-ms = <200>;
    quick-tap-ms = <200>;
};

/ {
    macros {
        lang_toggle: lang_toggle {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp F18 &kp LANG1>;
        };
    };

    behaviors {
        MIRYOKU_TD(td_base, 0)
        MIRYOKU_TD(td_nav, 1)
        MIRYOKU_TD(td_mouse, 2)
        MIRYOKU_TD(td_media, 3)
        MIRYOKU_TD(td_num, 4)
        MIRYOKU_TD(td_sym, 5)
        MIRYOKU_TD(td_fun, 6)
    };

    combos {
        compatible = "zmk,combos";

        lang_toggle_combo {
            bindings = <&lang_toggle>;
            key-positions = <30 33>;
        };

        caps_word_combo {
            bindings = <&caps_word>;
            key-positions = <31 32>;
            layers = <0>;
        };

        util_left {
            bindings = <&mo 7>;
            key-positions = <30 31>;
            layers = <0>;
            timeout-ms = <50>;
        };

        util_right {
            bindings = <&mo 7>;
            key-positions = <32 33>;
            layers = <0>;
            timeout-ms = <50>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // 0: BASE (Colemak-DH)

        base {
            bindings = <
&kp Q       &kp W       &kp F        &kp P        &kp B        &kp J       &kp L        &kp U        &kp Y       &kp SQT
&mt LGUI A  &mt LALT R  &mt LCTRL S  &mt LSHFT T  &kp G        &kp M       &mt RSHFT N  &mt RCTRL E  &mt RALT I  &mt RGUI O
&kp Z       &kp X       &kp C        &kp D        &kp V        &kp K       &kp H        &kp COMMA    &kp DOT     &kp SLASH
                                      &lt 1 SPACE  &lt 2 ESC    &lt 5 ENTER &lt 4 BSPC
            >;
        };

        // 1: NAV (hold pos 30 / SPACE)

        nav {
            bindings = <
&bootloader  &td_fun      &td_media    &td_base     &none        &kp K_REDO  &kp K_PASTE  &kp K_COPY   &kp K_CUT   &kp K_UNDO
&kp LGUI     &kp LALT     &kp LCTRL    &kp LSHFT    &none        &caps_word  &kp LEFT     &kp DOWN     &kp UP      &kp RIGHT
&none        &kp RALT     &td_num      &td_nav      &none        &kp INS     &kp HOME     &kp PG_DN    &kp PG_UP   &kp END
                                        &none        &none        &kp ENTER   &kp BSPC
            >;
        };

        // 2: MOUSE (hold pos 31 / ESC)

        mouse {
            bindings = <
&bootloader  &td_fun      &td_media    &td_base     &none        &kp K_REDO  &kp K_PASTE  &kp K_COPY      &kp K_CUT      &kp K_UNDO
&kp LGUI     &kp LALT     &kp LCTRL    &kp LSHFT    &none        &none       &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_UP   &mmv MOVE_RIGHT
&none        &kp RALT     &td_sym      &td_mouse    &none        &none       &msc SCRL_LEFT &msc SCRL_DOWN &msc SCRL_UP   &msc SCRL_RIGHT
                                        &none        &none        &mkp MB2    &mkp MB1
            >;
        };

        // 3: MEDIA (via &to 3)

        media {
            bindings = <
&bootloader  &td_fun      &td_media    &td_base     &none        &none           &none           &none           &none           &none
&kp LGUI     &kp LALT     &kp LCTRL    &kp LSHFT    &none        &out OUT_TOG    &kp C_PREV      &kp C_VOL_DN    &kp C_VOL_UP    &kp C_NEXT
&none        &kp RALT     &td_fun      &td_media    &none        &bt BT_CLR      &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3
                                        &none        &none        &kp C_STOP      &kp C_PP
            >;
        };

        // 4: NUM (hold pos 33 / BSPC)

        num {
            bindings = <
&kp LBKT     &kp N7       &kp N8       &kp N9       &kp RBKT     &none       &td_base     &td_media    &td_fun     &bootloader
&kp SEMI     &kp N4       &kp N5       &kp N6       &kp EQUAL    &none       &kp LSHFT    &kp LCTRL    &kp LALT    &kp LGUI
&kp GRAVE    &kp N1       &kp N2       &kp N3       &kp BSLH     &none       &td_num      &td_nav      &kp RALT    &none
                                        &kp N0       &kp MINUS    &none       &none
            >;
        };

        // 5: SYM (hold pos 32 / ENTER)

        sym {
            bindings = <
&kp LBRC     &kp AMPS     &kp ASTRK    &kp LPAR     &kp RBRC     &none       &td_base     &td_media    &td_fun     &bootloader
&kp COLON    &kp DLLR     &kp PRCNT    &kp CARET    &kp PLUS     &none       &kp LSHFT    &kp LCTRL    &kp LALT    &kp LGUI
&kp TILDE    &kp EXCL     &kp AT       &kp HASH     &kp PIPE     &none       &td_sym      &td_mouse    &kp RALT    &none
                                        &kp RPAR     &kp UNDER    &none       &none
            >;
        };

        // 6: FUN (via &to 6)

        fun {
            bindings = <
&kp F12      &kp F7       &kp F8       &kp F9       &kp PSCRN    &none       &td_base     &td_media    &td_fun     &bootloader
&kp F11      &kp F4       &kp F5       &kp F6       &kp SLCK     &none       &kp LSHFT    &kp LCTRL    &kp LALT    &kp LGUI
&kp F10      &kp F1       &kp F2       &kp F3       &kp PAUSE_BREAK &none    &td_fun      &td_media    &kp RALT    &none
                                        &kp SPACE    &kp TAB      &none       &none
            >;
        };

        // 7: UTIL (momentary via combo)

        util {
            bindings = <
&bootloader  &sys_reset   &none        &none        &none        &none       &none        &none        &sys_reset  &bootloader
&none        &none        &none        &none        &none        &none       &none        &none        &none       &none
&none        &none        &none        &none        &bt BT_CLR   &none       &none        &none        &none       &none
                                        &none        &none        &none       &none
            >;
        };
    };
};
